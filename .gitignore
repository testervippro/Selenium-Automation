# =========================================
# Build Output
# =========================================
/target/               # Maven build output folder
/out/                  # General output directory

# =========================================
# Maven
# =========================================
/.mvn/                 # Maven wrapper files
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties
.mvn/timing.properties
.mvn/maven.config
/.m2/                  # Local Maven repository cache (optional — usually NOT versioned)

# =========================================
# IDE Settings
# =========================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

